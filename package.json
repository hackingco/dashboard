{
  "name": "fly-swarm-orchestrator",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "shared/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "deploy": "turbo run deploy",
    "lint": "turbo run lint",
    "lint:all": "turbo run lint",
    "format:check": "turbo run format:check",
    "typecheck:all": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "test:coverage": "turbo run test:coverage",
    "test:smoke:staging": "turbo run test:smoke:staging",
    "test:smoke:production": "turbo run test:smoke:production",
    "test:smoke": "node tests/monitoring/observability-smoke-test.js",
    "test:smoke:websocket": "node tests/monitoring/websocket-realtime-test.js",
    "test:smoke:observability": "node tests/monitoring/observability-smoke-test.js",
    "build:all": "turbo run build",
    "langfuse:validate-v3": "node validate-langfuse-v3-config.js",
    "langfuse:start-v3": "docker-compose -f docker-compose.langfuse.yml up -d",
    "langfuse:stop-v3": "docker-compose -f docker-compose.langfuse.yml down",
    "langfuse:logs-v3": "docker-compose -f docker-compose.langfuse.yml logs -f",
    "test:langfuse-v3": "npm run langfuse:validate-v3 && npm run langfuse:start-v3"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@supabase/supabase-js": "^2.38.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.5.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/ui": "^1.0.0",
    "dotenv": "^16.3.1",
    "jsdom": "^23.2.0",
    "supertest": "^6.3.3",
    "turbo": "^1.10.16",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "zod": "^3.22.4"
  }
}
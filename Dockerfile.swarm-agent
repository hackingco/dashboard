FROM node:20-alpine

# Install system dependencies
RUN apk add --no-cache \
    sqlite \
    sqlite-dev \
    python3 \
    make \
    g++ \
    git \
    curl

# Set working directory
WORKDIR /app

# Copy simplified package file for Docker
COPY docker-package.json ./package.json

# Install dependencies
RUN npm install --omit=dev

# Copy application code
COPY . .
COPY shared/langfuse-wrapper ./shared/langfuse-wrapper

# Skip building Langfuse wrapper for simplified Docker deployment
# The wrapper is optional for basic swarm functionality

# Create data directory
RUN mkdir -p /app/data

# Copy agent script
COPY docker/swarm-agent.js ./

# Create health check script
RUN echo '#!/bin/sh\nps aux | grep "node swarm-agent.js" | grep -v grep || exit 1' > /app/healthcheck.sh && \
    chmod +x /app/healthcheck.sh

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD /app/healthcheck.sh

# Start agent
CMD ["node", "swarm-agent.js"]
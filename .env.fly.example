# Fly.io Environment Variables Template
# Copy this file to .env.fly and fill in the values

# Fly.io Authentication
FLY_API_TOKEN=your_fly_api_token_here

# Database Configuration (Supabase or Postgres)
DATABASE_URL=postgresql://user:password@host:port/database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# Redis Configuration (for BullMQ)
REDIS_URL=redis://default:password@host:port

# Dashboard Configuration
NEXT_PUBLIC_API_URL=https://swarm-manager.fly.dev
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Manager API Configuration
NODE_ENV=production
PORT=8080
CORS_ORIGIN=https://swarm-admin.fly.dev
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Worker Configuration
WORKER_TYPE=general
WORKER_CONCURRENCY=5
HEALTH_CHECK_INTERVAL=30000

# Observability (Future)
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_HOST=https://cloud.langfuse.com

# Trust Graph (Future)
TRUST_GRAPH_API_URL=https://your-trust-graph-instance.com
TRUST_GRAPH_API_KEY=your_trust_graph_api_key
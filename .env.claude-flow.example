# Claude Flow Docker Environment Configuration
# Copy this file to .env and update with your values

# Environment
NODE_ENV=production

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_DB=claude_flow

# Redis Configuration
REDIS_PASSWORD=your-secure-redis-password

# Application URLs
API_URL=http://localhost:8080
WS_URL=ws://localhost:8080
LANGFUSE_URL=http://localhost:3001

# JWT Configuration
JWT_SECRET=your-jwt-secret-min-32-chars-long-change-this

# Langfuse Configuration
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars-long
LANGFUSE_SALT=your-salt-min-32-chars-long
LANGFUSE_TELEMETRY_ENABLED=false
LANGFUSE_EXPERIMENTAL=false

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://dashboard:3000

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Worker Configuration
WORKER_CONCURRENCY=5
WORKER_NAME=worker-1
WORKER_REPLICAS=2

# Monitoring Configuration
GRAFANA_USER=admin
GRAFANA_PASSWORD=your-grafana-password

# Supabase Configuration (Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Fly.io Configuration (Optional)
FLY_API_TOKEN=your-fly-api-token

# OpenAI Configuration (Optional)
OPENAI_API_KEY=your-openai-api-key

# Anthropic Configuration (Optional)
ANTHROPIC_API_KEY=your-anthropic-api-key

# GitHub Configuration (Optional)
GITHUB_TOKEN=your-github-token
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Slack Configuration (Optional)
SLACK_BOT_TOKEN=your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Email Configuration (Optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM=noreply@example.com

# Feature Flags
ENABLE_METRICS=true
ENABLE_TRACING=true
ENABLE_WEBHOOKS=false
ENABLE_NOTIFICATIONS=false

# Resource Limits
MAX_UPLOAD_SIZE=10485760
MAX_CONCURRENT_TASKS=100
TASK_TIMEOUT=300000

# Security
ENCRYPTION_KEY=your-encryption-key-32-chars
API_KEY_SALT=your-api-key-salt

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Performance
CACHE_TTL=3600
CONNECTION_POOL_SIZE=10

# Development Settings (Change for production)
DEBUG=false
VERBOSE_ERRORS=false
# Docker Swarm Environment Configuration
# Copy this file to .env and customize the values

# ===========================================
# NODE ENVIRONMENT
# ===========================================
NODE_ENV=production

# ===========================================
# CORE INFRASTRUCTURE
# ===========================================

# Redis Configuration
REDIS_PORT=6379
REDIS_PASSWORD=swarm-redis-secure-password
REDIS_MAX_MEMORY=1gb

# PostgreSQL Configuration
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=swarm-postgres-secure-password
POSTGRES_DB=swarm_core

# ClickHouse Configuration
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_MYSQL_PORT=9004
CLICKHOUSE_DATABASE=langfuse
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse-secure-password

# ===========================================
# SWARM COORDINATION
# ===========================================

# Hive Mind Configuration
HIVE_MIND_PORT=8888
HIVE_MIND_SECRET=your-hive-mind-secret-key-min-32-chars
COORDINATION_TIMEOUT=30000
SWARM_MAX_AGENTS=50
NEURAL_PATTERNS=true
MEMORY_PERSISTENCE=true

# Claude Flow Configuration
CLAUDE_FLOW_PORT=8890
CLAUDE_FLOW_SECRET=your-claude-flow-secret-key-min-32-chars
MAX_AGENTS=20
COORDINATION_STRATEGY=adaptive

# Swarm Agent Configuration
SWARM_AGENT_REPLICAS=3
AGENT_TYPE=coder
AGENT_CAPABILITIES=coding,analysis,testing
MAX_COORDINATOR_TASKS=10
MAX_AGENT_TASKS=3

# ===========================================
# APPLICATION LAYER
# ===========================================

# Manager API Configuration
MANAGER_PORT=8080
JWT_SECRET=your-jwt-secret-key-min-32-chars-long

# Dashboard Configuration
DASHBOARD_PORT=3000

# Worker Configuration
WORKER_REPLICAS=2
WORKER_CONCURRENCY=5
WORKER_TYPE=general

# ===========================================
# OBSERVABILITY - LANGFUSE V3
# ===========================================

# Langfuse Configuration
LANGFUSE_PORT=3001
LANGFUSE_NEXTAUTH_SECRET=your-langfuse-nextauth-secret-min-32-chars-long
LANGFUSE_SALT=your-langfuse-salt-min-32-chars-long
LANGFUSE_EXPERIMENTAL=true
LANGFUSE_TELEMETRY_ENABLED=false
LANGFUSE_CACHE_TTL=3600
LANGFUSE_BATCH_SIZE=5000
LANGFUSE_FLUSH_INTERVAL=2000

# Langfuse Worker Configuration
LANGFUSE_WORKER_REPLICAS=2
LANGFUSE_WORKER_CONCURRENCY=20

# ===========================================
# EXTERNAL INTEGRATIONS
# ===========================================

# Fly.io Configuration
FLY_API_TOKEN=your-fly-api-token

# Supabase Configuration
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Langfuse API Keys
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key

# ===========================================
# MONITORING & OBSERVABILITY
# ===========================================

# Prometheus Configuration
PROMETHEUS_PORT=9090

# Grafana Configuration
GRAFANA_PORT=3030
GRAFANA_PASSWORD=secure-admin-password
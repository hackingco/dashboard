# Langfuse v3 Configuration for Claude Flow
# Copy this file to .env.langfuse and configure your Langfuse v3 settings
# v3 Features: ClickHouse analytics, Worker processing, Redis queuing, S3 storage

# ==============================================================================
# LANGFUSE v3 CONNECTION SETTINGS
# ==============================================================================

# Langfuse Public Key (required)
# Get this from your Langfuse dashboard -> Settings -> API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-1c8afc48-c76e-4abc-aa7a-7e02449ea4fd

# Langfuse Secret Key (required)
# Get this from your Langfuse dashboard -> Settings -> API Keys
LANGFUSE_SECRET_KEY=sk-lf-10ae3e48-9bea-4d06-84dd-2a83abc3fc86

# Langfuse Host URL (Web interface)
# For local development (default)
LANGFUSE_HOST=http://localhost:3001

# For cloud instance (production)
# LANGFUSE_HOST=https://cloud.langfuse.com

# For Next.js applications (browser-accessible)
NEXT_PUBLIC_LANGFUSE_PUBLIC_KEY=pk-lf-1c8afc48-c76e-4abc-aa7a-7e02449ea4fd
NEXT_PUBLIC_LANGFUSE_HOST=http://localhost:3001

# WebSocket endpoint for real-time updates (optional)
NEXT_PUBLIC_LANGFUSE_WS=ws://localhost:3001/ws

# ==============================================================================
# CLICKHOUSE v3 DATABASE CONFIGURATION
# ==============================================================================

# ClickHouse HTTP API URL (required for v3)
CLICKHOUSE_URL=http://localhost:8123

# ClickHouse Migration URL - Native protocol (required for v3)
CLICKHOUSE_MIGRATION_URL=clickhouse://localhost:9000

# ClickHouse Authentication
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_DATABASE=default

# ClickHouse Clustering (set to true for production clusters)
CLICKHOUSE_CLUSTER_ENABLED=false
CLICKHOUSE_CLUSTER_NAME=default

# ClickHouse Migration Settings
CLICKHOUSE_AUTO_MIGRATION_DISABLED=false

# ClickHouse Ports
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_MYSQL_PORT=9004

# ==============================================================================
# REDIS v3 QUEUE CONFIGURATION
# ==============================================================================

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_AUTH=swarm-redis
REDIS_PASSWORD=swarm-redis

# ==============================================================================
# S3/BLOB STORAGE CONFIGURATION (Optional but recommended for production)
# ==============================================================================

# S3 Configuration (leave empty to use local storage)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=langfuse-storage
S3_REGION=us-east-1

# For MinIO (local S3-compatible storage)
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin

# For AWS S3
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
# S3_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY

# ==============================================================================
# CLAUDE FLOW LANGFUSE v3 INTEGRATION SETTINGS
# ==============================================================================

# Enable/disable Langfuse v3 instrumentation
CLAUDE_FLOW_LANGFUSE_ENABLED=true

# Enable v3 features
LANGFUSE_V3_ENABLED=true

# Default session ID pattern
CLAUDE_FLOW_SESSION_PREFIX=claude-flow-swarm

# Default swarm ID
CLAUDE_FLOW_SWARM_ID=claude-flow-production

# Auto-flush traces to Langfuse v3
CLAUDE_FLOW_AUTO_FLUSH=true

# v3 Optimized flush interval in milliseconds
CLAUDE_FLOW_FLUSH_INTERVAL=3000

# v3 Enhanced batch size for trace operations
CLAUDE_FLOW_BATCH_SIZE=50

# Worker Configuration
LANGFUSE_WORKER_ENABLED=true
LANGFUSE_WORKER_CONCURRENCY=10

# ==============================================================================
# INSTRUMENTATION FEATURES
# ==============================================================================

# Log swarm coordination events
CLAUDE_FLOW_LOG_COORDINATION=true

# Log agent activities
CLAUDE_FLOW_LOG_AGENT_ACTIVITIES=true

# Log MCP tool usage
CLAUDE_FLOW_LOG_MCP_TOOLS=true

# Log performance metrics
CLAUDE_FLOW_LOG_METRICS=true

# Log neural network operations
CLAUDE_FLOW_LOG_NEURAL=true

# Log memory operations
CLAUDE_FLOW_LOG_MEMORY=true

# ==============================================================================
# LANGFUSE v3 PERFORMANCE SETTINGS
# ==============================================================================

# v3 Enhanced ingestion settings
LANGFUSE_MAX_INGESTION_BATCH_SIZE=10000
LANGFUSE_INGESTION_FLUSH_INTERVAL=1000
LANGFUSE_INGESTION_WORKERS=20
LANGFUSE_INGESTION_ENABLED=true

# Cache and performance
LANGFUSE_CACHE_TTL=3600

# ==============================================================================
# ADVANCED v3 SETTINGS
# ==============================================================================

# Trace sampling rate (0.0 to 1.0)
CLAUDE_FLOW_SAMPLE_RATE=1.0

# v3 Enhanced maximum trace queue size
CLAUDE_FLOW_MAX_QUEUE_SIZE=5000

# Connection timeout in milliseconds
CLAUDE_FLOW_CONNECTION_TIMEOUT=30000

# Retry attempts for failed traces
CLAUDE_FLOW_RETRY_ATTEMPTS=3

# Debug mode for instrumentation
CLAUDE_FLOW_DEBUG_MODE=false

# ==============================================================================
# ENVIRONMENT-SPECIFIC OVERRIDES
# ==============================================================================

# Development environment
NODE_ENV=development

# Production overrides (uncomment for production)
# NODE_ENV=production
# CLAUDE_FLOW_SAMPLE_RATE=0.1
# CLAUDE_FLOW_DEBUG_MODE=false
# CLAUDE_FLOW_FLUSH_INTERVAL=10000

# Staging overrides (uncomment for staging)
# NODE_ENV=staging
# CLAUDE_FLOW_SAMPLE_RATE=0.5
# LANGFUSE_HOST=https://staging.langfuse.com

# ==============================================================================
# SECURITY SETTINGS
# ==============================================================================

# Enable SSL verification (set to false only for development)
LANGFUSE_SSL_VERIFY=true

# Request timeout in milliseconds
LANGFUSE_REQUEST_TIMEOUT=30000

# Maximum request retries
LANGFUSE_MAX_RETRIES=3

# ==============================================================================
# INTEGRATION FEATURES
# ==============================================================================

# Enable GitHub integration logging
CLAUDE_FLOW_GITHUB_INTEGRATION=true

# Enable Docker container logging
CLAUDE_FLOW_DOCKER_INTEGRATION=true

# Enable VS Code extension logging
CLAUDE_FLOW_VSCODE_INTEGRATION=true

# Enable Supabase backend logging
CLAUDE_FLOW_SUPABASE_INTEGRATION=true

# ==============================================================================
# EXAMPLE USAGE COMMANDS
# ==============================================================================

# Initialize Langfuse with environment variables:
# npx claude-flow@alpha langfuse init

# Start swarm with Langfuse instrumentation:
# npx claude-flow@alpha swarm init --langfuse-enabled

# Monitor real-time traces:
# npx claude-flow@alpha langfuse monitor --real-time

# Export traces for analysis:
# npx claude-flow@alpha langfuse export --format json --output ./traces.json

# ==============================================================================
# TROUBLESHOOTING
# ==============================================================================

# Test Langfuse connection:
# npx claude-flow@alpha langfuse test-connection

# Validate configuration:
# npx claude-flow@alpha langfuse validate-config

# Check instrumentation status:
# npx claude-flow@alpha langfuse status

# Reset trace cache:
# npx claude-flow@alpha langfuse reset-cache
{
  "name": "@swarm-orchestration/utils",
  "version": "1.0.0",
  "description": "Common utility functions for Swarm Orchestration Platform",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "jest --testPathPattern=e2e",
    "test:coverage": "jest --coverage",
    "test:smoke:staging": "echo 'No smoke tests for utils package'",
    "test:smoke:production": "echo 'No smoke tests for utils package'",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "lint": "eslint src --ext .ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ruvnet/swarm-utils.git"
  },
  "keywords": [
    "swarm",
    "orchestration",
    "utils",
    "utilities",
    "helpers",
    "typescript"
  ],
  "author": "rUv",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ruvnet/swarm-utils/issues"
  },
  "homepage": "https://github.com/ruvnet/swarm-utils#readme",
  "dependencies": {
    "@swarm-orchestration/types": "^1.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.0",
    "typescript": "^5.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
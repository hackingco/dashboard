# Preview Environment Configuration for Vercel Deployment
NODE_ENV=development

# API Configuration
VITE_API_BASE_URL=https://your-swarm-manager.fly.dev/api
VITE_WS_URL=wss://your-swarm-manager.fly.dev/ws

# Dashboard Configuration
VITE_DASHBOARD_VERSION=2.0.0-preview
VITE_DASHBOARD_NAME="Swarm Control Dashboard (Preview)"
VITE_DASHBOARD_DESCRIPTION="Real-time swarm management and monitoring - Preview Build"

# Build Configuration
VITE_BUILD_TARGET=preview
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=true

# Performance Configuration
VITE_WS_RECONNECT_INTERVAL=3000
VITE_WS_MAX_RECONNECT_ATTEMPTS=10
VITE_API_TIMEOUT=60000
VITE_HEALTH_CHECK_INTERVAL=30000

# Feature Flags
VITE_ENABLE_REAL_TIME=true
VITE_ENABLE_MACHINE_SCALING=true
VITE_ENABLE_METRICS_DASHBOARD=true
VITE_ENABLE_ALERTS=true
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_PREVIEW_FEATURES=true

# Security Configuration
VITE_ENABLE_CSP=false
VITE_ENABLE_HSTS=false
VITE_ENABLE_CORS_VALIDATION=false

# Monitoring and Observability
VITE_LOG_LEVEL=debug
VITE_ENABLE_CONSOLE_LOGS=true
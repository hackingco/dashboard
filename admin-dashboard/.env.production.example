# Production Environment Configuration for Vercel Deployment
NODE_ENV=production

# API Configuration
VITE_API_BASE_URL=https://your-swarm-manager.fly.dev/api
VITE_WS_URL=wss://your-swarm-manager.fly.dev/ws

# Dashboard Configuration
VITE_DASHBOARD_VERSION=2.0.0
VITE_DASHBOARD_NAME="Swarm Control Dashboard"
VITE_DASHBOARD_DESCRIPTION="Real-time swarm management and monitoring"

# Build Configuration
VITE_BUILD_TARGET=production
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DEBUG=false

# Performance Configuration
VITE_WS_RECONNECT_INTERVAL=5000
VITE_WS_MAX_RECONNECT_ATTEMPTS=5
VITE_API_TIMEOUT=30000
VITE_HEALTH_CHECK_INTERVAL=60000

# Feature Flags
VITE_ENABLE_REAL_TIME=true
VITE_ENABLE_MACHINE_SCALING=true
VITE_ENABLE_METRICS_DASHBOARD=true
VITE_ENABLE_ALERTS=true
VITE_ENABLE_PERFORMANCE_MONITORING=true

# Security Configuration
VITE_ENABLE_CSP=true
VITE_ENABLE_HSTS=true
VITE_ENABLE_CORS_VALIDATION=true

# Monitoring and Observability
# VITE_SENTRY_DSN=your_sentry_dsn_here
# VITE_ANALYTICS_ID=your_analytics_id_here
VITE_LOG_LEVEL=error
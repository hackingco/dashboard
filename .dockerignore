# Docker ignore file for Langfuse Swarm testing

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp.*

# Build outputs
dist/
build/
out/
.next/

# Development files
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Documentation
README.md
CHANGELOG.md
*.md

# Test files
coverage/
.nyc_output/
test-results/

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
.tmp/

# Cache directories
.cache/
.parcel-cache/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Docker files (don't copy into container)
Dockerfile*
docker-compose*.yml
.dockerignore

# Backup files
*.bak
*.backup

# Database files
*.db
*.sqlite
*.sqlite3

# Memory store files
memory/
.swarm/

# Monitoring data
monitoring/data/
grafana-data/
prometheus-data/

# Fly.io specific
fly.toml

SUPABASE_DEFAULT_PROJECT=Swarm Dashboard

# Image Processing
IMGPROXY_ENABLE_WEBP_DETECTION=true

# Logging (Optional)
LOGFLARE_API_KEY=
LOGFLARE_URL=

# API Key for Swarm Services
SWARM_API_KEY=sk_swarm_api_key_change_in_production


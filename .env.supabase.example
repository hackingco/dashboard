# Supabase Configuration Environment Variables
# Copy this to .env.supabase and update the values

# Database Configuration
SUPABASE_DB_NAME=swarm_supabase
SUPABASE_DB_USER=supabase
SUPABASE_DB_PASSWORD=supabase_secure_password_change_me
SUPABASE_DB_PORT=5433

# JWT Configuration (IMPORTANT: Change these in production!)
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long-change-in-production
SUPABASE_JWT_EXPIRY=3600

# API Keys (IMPORTANT: Change these in production!)

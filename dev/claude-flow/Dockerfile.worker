FROM node:18-alpine AS base
RUN apk add --no-cache libc6-compat curl
WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci --only=production && npm cache clean --force

# Copy source code
COPY . .

# Create non-root user
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 claude-flow

# Set up directories
RUN mkdir -p .swarm .hive-mind logs
RUN chown -R claude-flow:nodejs .swarm .hive-mind logs

USER claude-flow

EXPOSE 8082

CMD ["node", "src/worker/agent-worker.js"]
{
  "name": "claude-flow-trace",
  "version": "1.0.0",
  "description": "Universal observability layer for Claude Flow AI orchestration - capture, monitor, and analyze every command",
  "keywords": [
    "claude-flow",
    "observability",
    "tracing",
    "monitoring",
    "langfuse",
    "ai-orchestration",
    "llm-monitoring",
    "performance-tracking",
    "real-time-analytics",
    "command-interception"
  ],
  "homepage": "https://github.com/ruvnet/claude-flow-trace",
  "bugs": {
    "url": "https://github.com/ruvnet/claude-flow-trace/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruvnet/claude-flow-trace.git"
  },
  "license": "MIT",
  "author": {
    "name": "Claude Flow Team",
    "email": "claude-flow-trace@example.com",
    "url": "https://github.com/ruvnet"
  },
  "main": "lib/index.js",
  "bin": {
    "claude-flow-trace": "./bin/claude-flow-trace.js",
    "cft": "./bin/claude-flow-trace.js"
  },
  "directories": {
    "lib": "lib",
    "test": "test",
    "doc": "docs"
  },
  "files": [
    "lib/",
    "bin/",
    "docs/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node lib/collector/index.js",
    "dev": "nodemon lib/collector/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint lib/**/*.js test/**/*.js",
    "lint:fix": "eslint lib/**/*.js test/**/*.js --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "setup": "node lib/setup/index.js",
    "collector": "node lib/collector/index.js",
    "client": "node lib/client/index.js",
    "dashboard": "node lib/dashboard/index.js",
    "benchmark": "node lib/benchmark/index.js",
    "prepublishOnly": "npm run lint && npm test",
    "prepare": "husky install"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "chokidar": "^3.5.3",
    "commander": "^11.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "langfuse": "^3.38.4",
    "ws": "^8.16.0",
    "winston": "^3.11.0",
    "dotenv": "^16.3.1",
    "joi": "^17.11.0",
    "uuid": "^9.0.1",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^27.6.3",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "lib/**/*.js",
      "!lib/**/*.test.js",
      "!lib/**/__tests__/**"
    ],
    "testMatch": [
      "**/test/**/*.test.js",
      "**/lib/**/*.test.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 100
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:jest/recommended",
      "prettier"
    ],
    "env": {
      "node": true,
      "es2022": true,
      "jest": true
    },
    "parserOptions": {
      "ecmaVersion": 2022,
      "sourceType": "module"
    },
    "rules": {
      "no-console": "off",
      "no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_"
        }
      ]
    }
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/ruvnet"
  }
}
# 🐝 Claude Flow Swarm Wrapper Environment Configuration
# Copy this file to .env and customize for your deployment

# ═══════════════════════════════════════════════════════════════
# 🏗️ INFRASTRUCTURE SETTINGS
# ═══════════════════════════════════════════════════════════════

# Environment
NODE_ENV=production
DEPLOYMENT_MODE=docker-swarm

# ═══════════════════════════════════════════════════════════════
# 🔌 PORT CONFIGURATION
# ═══════════════════════════════════════════════════════════════

# Core Infrastructure Ports
POSTGRES_PORT=5432
REDIS_PORT=6379
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_MYSQL_PORT=9004

# Swarm Coordination Ports
HIVE_MIND_PORT=8888
CLAUDE_FLOW_PORT=8889
SWARM_COORDINATOR_PORT=8890

# Application Ports
MANAGER_PORT=8080
DASHBOARD_PORT=3000
LANGFUSE_PORT=3001

# Load Balancer & Monitoring Ports
HTTP_PORT=80
HTTPS_PORT=443
PROMETHEUS_PORT=9090
GRAFANA_PORT=3030

# ═══════════════════════════════════════════════════════════════
# 🗄️ DATABASE CONFIGURATION
# ═══════════════════════════════════════════════════════════════

# PostgreSQL - Primary Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=pQCMqissMoUYvgpEUcqSAfnTTzgUXsjDc4F5c9PDgFA=
POSTGRES_DB=swarm_production

# ClickHouse - Analytics Database for Langfuse v3
CLICKHOUSE_DATABASE=swarm_analytics
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=swarm-clickhouse-2024-CHANGE-ME

# Redis - Cache and Coordination
REDIS_PASSWORD=swarm-redis-2024-CHANGE-ME

# ═══════════════════════════════════════════════════════════════
# 🔐 SECURITY & AUTHENTICATION
# ═══════════════════════════════════════════════════════════════

# JWT & Session Security
JWT_SECRET=swarm-jwt-secret-min-32-chars-long-CHANGE-ME-2024
SESSION_SECRET=swarm-session-secret-min-32-chars-long-CHANGE-ME-2024

# Langfuse v3 Security
LANGFUSE_NEXTAUTH_SECRET=swarm-langfuse-nextauth-secret-min-32-chars-long-CHANGE-ME-2024
LANGFUSE_SALT=swarm-langfuse-salt-min-32-chars-long-CHANGE-ME-2024

# Grafana Admin Password
GRAFANA_PASSWORD=swarm-grafana-admin-CHANGE-ME-2024

# ═══════════════════════════════════════════════════════════════
# 🔗 LANGFUSE v3 INTEGRATION
# ═══════════════════════════════════════════════════════════════

# Langfuse API Keys (Get from https://langfuse.com)
LANGFUSE_PUBLIC_KEY=pk-lf-YOUR-PUBLIC-KEY-HERE
LANGFUSE_SECRET_KEY=sk-lf-YOUR-SECRET-KEY-HERE

# Langfuse URLs
LANGFUSE_URL=http://localhost:3001
LANGFUSE_HOST=http://langfuse:3000

# ═══════════════════════════════════════════════════════════════
# ⚡ PERFORMANCE & SCALING SETTINGS
# ═══════════════════════════════════════════════════════════════

# Swarm Configuration
SWARM_MAX_AGENTS=50
SWARM_COORDINATION_MODE=hierarchical
NEURAL_PATTERNS_ENABLED=true

# Agent Configuration
AGENT_TYPE=coder
COORDINATOR_MAX_TASKS=50
AGENT_MAX_TASKS=10
AGENT_TASK_TIMEOUT=300000
AGENT_MEMORY_LIMIT=512
COORDINATION_STRATEGY=hierarchical

# Langfuse v3 Performance (ClickHouse optimized)
LANGFUSE_WORKER_CONCURRENCY=20
LANGFUSE_WORKER_REPLICAS=3
LANGFUSE_BATCH_SIZE=10000
LANGFUSE_FLUSH_INTERVAL=1000
LANGFUSE_CACHE_TTL=3600

# ClickHouse Auto-Migration
CLICKHOUSE_AUTO_MIGRATION_DISABLED=false

# ═══════════════════════════════════════════════════════════════
# ☁️ CLOUD STORAGE (OPTIONAL - For Production)
# ═══════════════════════════════════════════════════════════════

# S3-Compatible Storage for Langfuse v3
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_ACCESS_KEY_ID=YOUR_ACCESS_KEY
# S3_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
# S3_BUCKET_NAME=langfuse-swarm-storage
# S3_REGION=us-east-1

# ═══════════════════════════════════════════════════════════════
# 🔧 EXTERNAL INTEGRATIONS
# ═══════════════════════════════════════════════════════════════

# Supabase (Optional - if using Supabase instead of local PostgreSQL)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI/Anthropic API Keys
# OPENAI_API_KEY=sk-your-openai-key
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# ═══════════════════════════════════════════════════════════════
# 🔍 TELEMETRY & MONITORING
# ═══════════════════════════════════════════════════════════════

# Langfuse Telemetry
LANGFUSE_TELEMETRY_ENABLED=false
LANGFUSE_EXPERIMENTAL=true

# Swarm Monitoring
SWARM_TRACING_ENABLED=true
SWARM_AGENT_TRACKING=true
SWARM_WORKER_MODE=true

# ═══════════════════════════════════════════════════════════════
# 🌍 NETWORKING & DNS
# ═══════════════════════════════════════════════════════════════

# External URLs (for production deployment)
# PUBLIC_DASHBOARD_URL=https://your-swarm-dashboard.com
# PUBLIC_API_URL=https://your-swarm-api.com
# PUBLIC_LANGFUSE_URL=https://your-swarm-langfuse.com

# ═══════════════════════════════════════════════════════════════
# 📝 DEPLOYMENT NOTES
# ═══════════════════════════════════════════════════════════════

# 🚀 Quick Start Commands:
# 
# 1. Copy this file:
#    cp .env.swarm-wrapper.example .env
# 
# 2. Generate secure passwords:
#    openssl rand -base64 32  # Run this for each password field
# 
# 3. Set your Langfuse keys:
#    Get them from https://langfuse.com/settings
# 
# 4. Start the swarm:
#    docker-compose -f docker-compose.swarm-wrapper.yml up
# 
# 5. Scale agents:
#    docker-compose -f docker-compose.swarm-wrapper.yml up --scale swarm-agent=10
# 
# 🔧 Service URLs after startup:
# - Dashboard: http://localhost:3000
# - Manager API: http://localhost:8080
# - Hive Mind: http://localhost:8888
# - Claude Flow: http://localhost:8889
# - Langfuse v3: http://localhost:3001
# - Prometheus: http://localhost:9090
# - Grafana: http://localhost:3030

# ⚠️ SECURITY WARNINGS:
# - Change ALL default passwords before production deployment
# - Use strong, unique passwords for each service
# - Consider using Docker secrets for sensitive data in production
# - Enable SSL/TLS for production deployments
# - Restrict network access to necessary services only
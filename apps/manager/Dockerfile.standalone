FROM node:18-alpine

WORKDIR /app

# Install dependencies
RUN apk add --no-cache libc6-compat python3 make g++

# Copy package.json with standalone dependencies (no workspace refs)
COPY package.standalone.json package.json

# Install dependencies
RUN npm install --production

# Copy built source code (dist folder should be pre-built)
COPY dist ./dist

# Copy any shared package files that were built locally
COPY shared ./shared

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nodeuser

# Change ownership
RUN chown -R nodeuser:nodejs /app

USER nodeuser

EXPOSE 8080

ENV NODE_ENV=production
ENV PORT=8080

CMD ["node", "dist/index.js"]
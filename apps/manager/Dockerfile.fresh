FROM node:18-alpine AS base

# Build shared packages stage
FROM base AS shared-builder
WORKDIR /shared

# Copy and build shared packages
COPY ../../shared/types ./types
COPY ../../shared/utils ./utils  
COPY ../../shared/supabase ./supabase

# Build each shared package
WORKDIR /shared/types
RUN npm install && npm run build

WORKDIR /shared/utils
RUN npm install && npm run build

WORKDIR /shared/supabase
RUN npm install && npm run build

# Main application stage
FROM base AS runner
WORKDIR /app

# Copy package.json and install dependencies
COPY package.deploy.json ./package.json
RUN npm install --production --legacy-peer-deps

# Copy built application
COPY dist ./dist

# Copy built shared packages from builder stage
COPY --from=shared-builder /shared/types/dist ./node_modules/@swarm/types/dist
COPY --from=shared-builder /shared/types/package.json ./node_modules/@swarm/types/package.json
COPY --from=shared-builder /shared/utils/dist ./node_modules/@swarm/utils/dist
COPY --from=shared-builder /shared/utils/package.json ./node_modules/@swarm/utils/package.json
COPY --from=shared-builder /shared/supabase/dist ./node_modules/@swarm/supabase/dist
COPY --from=shared-builder /shared/supabase/package.json ./node_modules/@swarm/supabase/package.json

# Copy supabase dependencies
COPY --from=shared-builder /shared/supabase/node_modules/@supabase ./node_modules/@supabase

# Create index.js files for each shared package
RUN echo 'module.exports = require("./dist/index.js");' > node_modules/@swarm/types/index.js && \
    echo 'module.exports = require("./dist/index.js");' > node_modules/@swarm/utils/index.js && \
    echo 'module.exports = require("./dist/index.js");' > node_modules/@swarm/supabase/index.js

# Create non-root user
RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001 && \
    chown -R nodejs:nodejs /app

USER nodejs

EXPOSE 8080

CMD ["node", "dist/index.js"]
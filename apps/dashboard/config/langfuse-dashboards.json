{
  "dashboards": [
    {
      "id": "swarm-overview",
      "name": "Swarm Overview Dashboard",
      "description": "High-level view of swarm operations and health",
      "refresh_interval": 5000,
      "layout": {
        "type": "grid",
        "columns": 12,
        "rows": 8
      },
      "widgets": [
        {
          "id": "health-score",
          "type": "gauge",
          "title": "System Health",
          "position": { "x": 0, "y": 0, "w": 3, "h": 2 },
          "config": {
            "metric": "system.health.overall",
            "thresholds": [
              { "value": 90, "color": "#10b981", "label": "Excellent" },
              { "value": 70, "color": "#f59e0b", "label": "Good" },
              { "value": 50, "color": "#ef4444", "label": "Poor" }
            ],
            "max": 100,
            "unit": "%"
          }
        },
        {
          "id": "active-agents",
          "type": "stat",
          "title": "Active Agents",
          "position": { "x": 3, "y": 0, "w": 3, "h": 2 },
          "config": {
            "metric": "agents.active.count",
            "comparison": "agents.total.count",
            "format": "{value}/{comparison}",
            "trend": true,
            "sparkline": true
          }
        },
        {
          "id": "throughput",
          "type": "stat",
          "title": "Throughput",
          "position": { "x": 6, "y": 0, "w": 3, "h": 2 },
          "config": {
            "metric": "traces.throughput.per_minute",
            "unit": "traces/min",
            "trend": true,
            "change_period": "1h"
          }
        },
        {
          "id": "error-rate",
          "type": "stat",
          "title": "Error Rate",
          "position": { "x": 9, "y": 0, "w": 3, "h": 2 },
          "config": {
            "metric": "traces.error_rate",
            "unit": "%",
            "thresholds": [
              { "value": 5, "color": "#ef4444" },
              { "value": 2, "color": "#f59e0b" },
              { "value": 0, "color": "#10b981" }
            ],
            "invert_colors": true
          }
        },
        {
          "id": "trace-timeline",
          "type": "area_chart",
          "title": "Trace Volume Over Time",
          "position": { "x": 0, "y": 2, "w": 8, "h": 3 },
          "config": {
            "metrics": [
              { "id": "traces.success", "color": "#10b981", "name": "Success" },
              { "id": "traces.error", "color": "#ef4444", "name": "Error" },
              { "id": "traces.pending", "color": "#f59e0b", "name": "Pending" }
            ],
            "stacked": true,
            "time_range": "1h",
            "granularity": "1m"
          }
        },
        {
          "id": "cost-tracker",
          "type": "line_chart",
          "title": "Cost Tracking",
          "position": { "x": 8, "y": 2, "w": 4, "h": 3 },
          "config": {
            "metrics": [
              { "id": "cost.per_hour", "color": "#8b5cf6", "name": "Hourly Cost" },
              { "id": "cost.projection.daily", "color": "#06b6d4", "name": "Daily Projection", "dashed": true }
            ],
            "y_axis": {
              "format": "currency",
              "currency": "USD"
            }
          }
        },
        {
          "id": "agent-grid",
          "type": "agent_status_grid",
          "title": "Agent Status",
          "position": { "x": 0, "y": 5, "w": 6, "h": 3 },
          "config": {
            "show_fields": ["name", "status", "current_task", "cpu", "memory"],
            "status_colors": {
              "active": "#10b981",
              "idle": "#6b7280",
              "error": "#ef4444",
              "offline": "#1f2937"
            },
            "compact": false
          }
        },
        {
          "id": "recent-alerts",
          "type": "alert_list",
          "title": "Recent Alerts",
          "position": { "x": 6, "y": 5, "w": 6, "h": 3 },
          "config": {
            "max_items": 5,
            "severity_filter": ["critical", "warning"],
            "show_acknowledged": false,
            "auto_dismiss": 300000
          }
        }
      ]
    },
    {
      "id": "trace-analysis",
      "name": "Trace Analysis Dashboard",
      "description": "Detailed trace analysis and debugging",
      "refresh_interval": 10000,
      "layout": {
        "type": "grid",
        "columns": 12,
        "rows": 10
      },
      "widgets": [
        {
          "id": "trace-explorer",
          "type": "trace_table",
          "title": "Live Trace Explorer",
          "position": { "x": 0, "y": 0, "w": 12, "h": 4 },
          "config": {
            "columns": [
              { "field": "timestamp", "width": 150, "format": "time" },
              { "field": "name", "width": 300 },
              { "field": "status", "width": 100, "format": "status_badge" },
              { "field": "duration", "width": 100, "format": "duration" },
              { "field": "model", "width": 150 },
              { "field": "total_cost", "width": 100, "format": "currency" },
              { "field": "agent_id", "width": 150 }
            ],
            "filters": {
              "status": "all",
              "model": "all",
              "time_range": "15m"
            },
            "sorting": {
              "field": "timestamp",
              "order": "desc"
            },
            "row_click_action": "show_detail"
          }
        },
        {
          "id": "latency-distribution",
          "type": "histogram",
          "title": "Response Time Distribution",
          "position": { "x": 0, "y": 4, "w": 4, "h": 3 },
          "config": {
            "metric": "traces.duration",
            "buckets": [0, 100, 250, 500, 1000, 2000, 5000, 10000],
            "unit": "ms",
            "color": "#3b82f6"
          }
        },
        {
          "id": "model-performance",
          "type": "bar_chart",
          "title": "Model Performance Comparison",
          "position": { "x": 4, "y": 4, "w": 4, "h": 3 },
          "config": {
            "metrics": [
              { "id": "model.avg_duration", "group_by": "model" },
              { "id": "model.avg_cost", "group_by": "model", "y_axis": "right" }
            ],
            "orientation": "vertical"
          }
        },
        {
          "id": "error-analysis",
          "type": "pie_chart",
          "title": "Error Breakdown",
          "position": { "x": 8, "y": 4, "w": 4, "h": 3 },
          "config": {
            "metric": "traces.errors.count",
            "group_by": "error_type",
            "show_legend": true,
            "show_values": true
          }
        },
        {
          "id": "trace-waterfall",
          "type": "trace_waterfall",
          "title": "Trace Waterfall View",
          "position": { "x": 0, "y": 7, "w": 12, "h": 3 },
          "config": {
            "trace_id": "selected",
            "show_spans": true,
            "show_metadata": true,
            "color_by": "service",
            "time_format": "relative"
          }
        }
      ]
    },
    {
      "id": "performance-analytics",
      "name": "Performance Analytics",
      "description": "Deep performance insights and optimization opportunities",
      "refresh_interval": 30000,
      "layout": {
        "type": "grid",
        "columns": 12,
        "rows": 8
      },
      "widgets": [
        {
          "id": "performance-overview",
          "type": "multi_stat",
          "title": "Performance KPIs",
          "position": { "x": 0, "y": 0, "w": 12, "h": 2 },
          "config": {
            "stats": [
              { "metric": "performance.p50", "label": "P50 Latency", "unit": "ms" },
              { "metric": "performance.p95", "label": "P95 Latency", "unit": "ms" },
              { "metric": "performance.p99", "label": "P99 Latency", "unit": "ms" },
              { "metric": "performance.apdex", "label": "Apdex Score", "format": "decimal" }
            ]
          }
        },
        {
          "id": "latency-heatmap",
          "type": "heatmap",
          "title": "Latency Heatmap",
          "position": { "x": 0, "y": 2, "w": 6, "h": 3 },
          "config": {
            "x_axis": "time",
            "y_axis": "agent_id",
            "metric": "traces.duration",
            "color_scale": "viridis",
            "buckets": 20
          }
        },
        {
          "id": "resource-correlation",
          "type": "scatter_plot",
          "title": "Resource vs Performance",
          "position": { "x": 6, "y": 2, "w": 6, "h": 3 },
          "config": {
            "x_metric": "resource.cpu_usage",
            "y_metric": "traces.duration",
            "size_metric": "traces.token_count",
            "color_by": "agent_type",
            "show_regression": true
          }
        },
        {
          "id": "bottleneck-analysis",
          "type": "funnel_chart",
          "title": "Pipeline Bottlenecks",
          "position": { "x": 0, "y": 5, "w": 4, "h": 3 },
          "config": {
            "stages": [
              { "name": "Request Received", "metric": "pipeline.requests" },
              { "name": "Agent Assigned", "metric": "pipeline.assigned" },
              { "name": "Processing", "metric": "pipeline.processing" },
              { "name": "Completed", "metric": "pipeline.completed" }
            ]
          }
        },
        {
          "id": "optimization-recommendations",
          "type": "recommendation_list",
          "title": "Optimization Opportunities",
          "position": { "x": 4, "y": 5, "w": 8, "h": 3 },
          "config": {
            "categories": ["performance", "cost", "reliability"],
            "impact_threshold": "medium",
            "auto_generate": true,
            "max_recommendations": 5
          }
        }
      ]
    },
    {
      "id": "cost-management",
      "name": "Cost Management Dashboard",
      "description": "Financial insights and cost optimization",
      "refresh_interval": 60000,
      "layout": {
        "type": "grid",
        "columns": 12,
        "rows": 8
      },
      "widgets": [
        {
          "id": "cost-summary",
          "type": "cost_summary",
          "title": "Cost Overview",
          "position": { "x": 0, "y": 0, "w": 4, "h": 2 },
          "config": {
            "periods": ["hour", "day", "month"],
            "show_projection": true,
            "currency": "USD"
          }
        },
        {
          "id": "cost-by-model",
          "type": "donut_chart",
          "title": "Cost by Model",
          "position": { "x": 4, "y": 0, "w": 4, "h": 2 },
          "config": {
            "metric": "cost.total",
            "group_by": "model",
            "time_range": "24h"
          }
        },
        {
          "id": "cost-efficiency",
          "type": "efficiency_gauge",
          "title": "Cost Efficiency",
          "position": { "x": 8, "y": 0, "w": 4, "h": 2 },
          "config": {
            "metric": "cost.per_successful_trace",
            "benchmark": 0.01,
            "format": "currency"
          }
        },
        {
          "id": "cost-trends",
          "type": "area_chart",
          "title": "Cost Trends",
          "position": { "x": 0, "y": 2, "w": 8, "h": 3 },
          "config": {
            "metrics": [
              { "id": "cost.prompt_tokens", "name": "Prompt Tokens" },
              { "id": "cost.completion_tokens", "name": "Completion Tokens" },
              { "id": "cost.total", "name": "Total Cost" }
            ],
            "time_range": "7d",
            "show_forecast": true
          }
        },
        {
          "id": "budget-tracker",
          "type": "budget_progress",
          "title": "Budget Tracking",
          "position": { "x": 8, "y": 2, "w": 4, "h": 3 },
          "config": {
            "budgets": [
              { "name": "Daily", "limit": 100, "period": "day" },
              { "name": "Monthly", "limit": 2000, "period": "month" }
            ],
            "show_alerts": true
          }
        },
        {
          "id": "cost-anomalies",
          "type": "anomaly_detection",
          "title": "Cost Anomalies",
          "position": { "x": 0, "y": 5, "w": 12, "h": 3 },
          "config": {
            "metric": "cost.per_hour",
            "sensitivity": "medium",
            "lookback_period": "7d",
            "show_predictions": true
          }
        }
      ]
    }
  ],
  "global_settings": {
    "theme": "auto",
    "timezone": "browser",
    "number_format": "compact",
    "date_format": "relative",
    "color_scheme": "default",
    "animations": true,
    "data_refresh": {
      "strategy": "smart",
      "min_interval": 1000,
      "max_interval": 60000
    }
  }
}
# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Database Connection (optional - for direct connections)
DATABASE_URL=postgresql://postgres:[password]@[host]:[port]/[database]

# Manager API
MANAGER_URL=http://localhost:8080

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3004
NODE_ENV=development

# Real-time Configuration
NEXT_PUBLIC_ENABLE_REALTIME=true
NEXT_PUBLIC_REALTIME_REFRESH_INTERVAL=3000

# Swarm Configuration
NEXT_PUBLIC_DEFAULT_SWARM_ID=swarm_observability
NEXT_PUBLIC_DEFAULT_SESSION_ID=verified-swarm-1752447894027
NEXT_PUBLIC_MAX_TRACES=100
NEXT_PUBLIC_MAX_AGENTS=20

# Security Configuration
NEXT_PUBLIC_ENABLE_AUTH=false
NEXT_PUBLIC_DEMO_MODE=true

# Monitoring Configuration
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_ERROR_TRACKING=true

# Performance Configuration
NEXT_PUBLIC_LAZY_LOADING=true
NEXT_PUBLIC_VIRTUALIZATION=true

# API Configuration
API_RATE_LIMIT=100
API_TIMEOUT=30000

# Development Configuration
NEXT_PUBLIC_DEBUG_MODE=false
NEXT_PUBLIC_SHOW_DEV_TOOLS=false

# Observability (Langfuse Configuration)
# For local Langfuse instance (recommended for development)
NEXT_PUBLIC_LANGFUSE_PUBLIC_KEY=pk-lf-1c8afc48-c76e-4abc-aa7a-7e02449ea4fd
LANGFUSE_SECRET_KEY=sk-lf-10ae3e48-9bea-4d06-84dd-2a83abc3fc86
NEXT_PUBLIC_LANGFUSE_HOST=http://localhost:3000
NEXT_PUBLIC_LANGFUSE_WS=ws://localhost:3000/ws

# For cloud Langfuse instance (production)
# NEXT_PUBLIC_LANGFUSE_PUBLIC_KEY=your-cloud-public-key
# LANGFUSE_SECRET_KEY=your-cloud-secret-key
# NEXT_PUBLIC_LANGFUSE_HOST=https://cloud.langfuse.com
# NEXT_PUBLIC_LANGFUSE_WS=wss://cloud.langfuse.com/ws

# Langfuse Features
LANGFUSE_ENABLED=true
LANGFUSE_FLUSH_AT=20
LANGFUSE_FLUSH_INTERVAL=10000
LANGFUSE_ENABLE_REALTIME=true
LANGFUSE_AUTO_FLUSH=true

# TrustGraph (Optional)
NEXT_PUBLIC_TRUSTGRAPH_API_KEY=
NEXT_PUBLIC_TRUSTGRAPH_API_URL=
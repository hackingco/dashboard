{
  "name": "@swarm/dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:smoke:staging": "vitest run --config vitest.smoke.config.ts --reporter=verbose",
    "test:smoke:production": "vitest run --config vitest.smoke.config.ts --reporter=verbose",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "deploy": "fly deploy"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/supabase-js": "^2.38.0",
    "@swarm/supabase": "workspace:*",
    "@swarm/types": "workspace:*",
    "@swarm/utils": "workspace:*",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-query-devtools": "^5.82.0",
    "chart.js": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.0.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.290.0",
    "next": "14.0.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.9.0",
    "tailwind-merge": "^2.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.31",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
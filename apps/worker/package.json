{
  "name": "@swarm/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "jest --testPathPattern=e2e",
    "test:coverage": "jest --coverage",
    "test:smoke:staging": "jest --testPathPattern=smoke --verbose",
    "test:smoke:production": "jest --testPathPattern=smoke --verbose",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "deploy": "fly deploy"
  },
  "dependencies": {
    "@swarm/types": "workspace:*",
    "@swarm/utils": "workspace:*",
    "bullmq": "^4.14.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "redis": "^4.6.10",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "tsx": "^4.6.2",
    "typescript": "^5.0.0"
  }
}
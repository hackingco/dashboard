{
  "name": "@swarm/manager",
  "version": "1.0.0",
  "description": "Swarm manager service for Fly.io deployment with Langfuse integration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write 'src/**/*.ts'",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@swarm/langfuse-wrapper": "workspace:*",
    "@swarm/types": "workspace:*",
    "@swarm/utils": "workspace:*",
    "express": "^4.18.2",
    "better-sqlite3": "^11.6.0",
    "ws": "^8.17.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "winston": "^3.11.0",
    "uuid": "^11.1.0",
    "node-cron": "^3.0.3",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.10",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^10.0.0",
    "@types/jest": "^29.5.11",
    "typescript": "^5.0.0",
    "ts-node": "^10.9.1",
    "jest": "^29.7.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
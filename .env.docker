# Docker Swarm with Langfuse Configuration
# Copy this to .env and configure with your actual keys

# Langfuse Configuration
LANGFUSE_PUBLIC_KEY=pk_lf_your_public_key_here
LANGFUSE_SECRET_KEY=sk_lf_your_secret_key_here
LANGFUSE_HOST=http://langfuse:3000

# Database Configuration
POSTGRES_DB=langfuse
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=langfuse_secure_password_change_in_production

# Redis Configuration
REDIS_URL=redis://redis:6379

# Swarm Configuration
SWARM_ID=docker-swarm-production
AGENT_COUNT=8
COORDINATOR_PORT=8000
DASHBOARD_PORT=3001

# Memory and Performance
MEMORY_DB_PATH=/app/data/memory.db
HEARTBEAT_INTERVAL=30000
MAX_RETRIES=3

# Security (Change in production)
NEXTAUTH_SECRET=change-this-in-production-very-long-secret-key
SALT=change-this-salt-in-production

# Optional: If you have existing Langfuse cloud setup
# LANGFUSE_PUBLIC_KEY=pk_lf_your_cloud_key
# LANGFUSE_SECRET_KEY=sk_lf_your_cloud_secret
# LANGFUSE_HOST=https://cloud.langfuse.com

# Development overrides
NODE_ENV=production
LOG_LEVEL=info
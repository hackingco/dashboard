# Langfuse Configuration for Live API Integration
# This file contains environment variables for connecting to live Langfuse instance

# Langfuse API Configuration
LANGFUSE_PUBLIC_KEY=pk-lf-1234567890abcdef
LANGFUSE_SECRET_KEY=sk-lf-fedcba0987654321
LANGFUSE_HOST=http://localhost:3050
LANGFUSE_ENABLED=true

# Real-time WebSocket Configuration
LANGFUSE_WS_ENDPOINT=ws://localhost:3050/ws
LANGFUSE_REALTIME_ENABLED=true
LANGFUSE_AUTO_FLUSH=true
LANGFUSE_FLUSH_INTERVAL=5000

# Swarm Coordination
SWARM_ID=dashboard-integration-swarm
AGENT_ID=dashboard-integration
AGENT_ROLE=dashboard

# Dashboard API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_LANGFUSE_HOST=http://localhost:3050
NEXT_PUBLIC_LANGFUSE_WS=ws://localhost:3050/ws
NEXT_PUBLIC_REALTIME_REFRESH_INTERVAL=2000

# Database and Cache
REDIS_URL=redis://localhost:6379
POSTGRES_URL=postgresql://langfuse:langfuse_secret@localhost:5432/langfuse

# Security
NEXTAUTH_SECRET=dashboard_nextauth_secret_change_in_production
ENCRYPTION_KEY=dashboard_encryption_key_change_in_production

# Monitoring and Logging
LOG_LEVEL=debug
TELEMETRY_ENABLED=true
METRICS_COLLECTION=true

# Feature Flags
FEATURE_REAL_TIME_TRACING=true
FEATURE_LIVE_AGENT_MONITORING=true
FEATURE_TOKEN_COST_TRACKING=true
FEATURE_SWARM_COORDINATION=true
FEATURE_WEBHOOK_STREAMING=true

# Production overrides (comment out for development)
# LANGFUSE_HOST=https://your-langfuse-instance.com
# LANGFUSE_WS_ENDPOINT=wss://your-langfuse-instance.com/ws
# NEXT_PUBLIC_LANGFUSE_HOST=https://your-langfuse-instance.com
# NEXT_PUBLIC_LANGFUSE_WS=wss://your-langfuse-instance.com/ws
# Production-ready Multi-stage Dockerfile for Dashboard
# Optimized for Next.js production deployment

# Stage 1: Base dependencies
FROM node:18-alpine AS base-deps

# Install security updates and build dependencies
RUN apk update && \
    apk upgrade && \
    apk add --no-cache \
        curl \
        tini \
        ca-certificates && \
    rm -rf /var/cache/apk/*

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

# Stage 2: Dependencies
FROM base-deps AS deps

WORKDIR /app

# Copy package files
COPY apps/dashboard/package*.json ./

# Install dependencies with frozen lockfile
RUN npm ci --quiet

# Stage 3: Builder
FROM base-deps AS builder

WORKDIR /app

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules
COPY apps/dashboard ./

# Set build-time environment variables
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_LANGFUSE_HOST
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_LANGFUSE_HOST=${NEXT_PUBLIC_LANGFUSE_HOST}

# Build the Next.js application
RUN npm run build

# Stage 4: Production runner
FROM base-deps AS runner

WORKDIR /app

# Set production environment
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Use tini for proper signal handling
ENTRYPOINT ["/sbin/tini", "--"]

# Switch to non-root user
USER nodejs

# Copy necessary files from builder
COPY --from=builder --chown=nodejs:nodejs /app/public ./public
COPY --from=builder --chown=nodejs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nodejs:nodejs /app/.next/static ./.next/static

# Create necessary directories
RUN mkdir -p /app/.next/cache

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:${PORT:-3000}/api/health || exit 1

# Expose port
EXPOSE 3000

# Labels
LABEL maintainer="swarm-team" \
      version="1.0.0" \
      description="Swarm Dashboard Service" \
      security.scan="trivy"

# Start the server
CMD ["node", "server.js"]
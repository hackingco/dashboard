# Claude Flow Docker Environment Configuration
# Copy to .env and customize for your deployment

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Deployment mode: development, production, scaling
NODE_ENV=production

# Network configuration
HTTP_PORT=80
HTTPS_PORT=443

# =============================================================================
# CORE INFRASTRUCTURE
# =============================================================================

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_DB=swarm_core
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PASSWORD=your-secure-redis-password
REDIS_PORT=6379
REDIS_MAX_MEMORY=512mb

# Hive Mind Configuration
HIVE_MIND_PORT=8888
HIVE_MIND_SECRET=your-hive-mind-secret-key
COORDINATION_TIMEOUT=30000
SWARM_MAX_AGENTS=20

# =============================================================================
# APPLICATION SERVICES
# =============================================================================

# Manager API Configuration
MANAGER_PORT=8080
JWT_SECRET=your-jwt-secret-min-32-characters-long
CORS_ORIGINS=http://localhost:3000,http://dashboard:3000
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Dashboard Configuration
DASHBOARD_PORT=3000
API_URL=http://localhost:8080
WS_URL=ws://localhost:8080

# Worker Configuration
WORKER_CONCURRENCY=5
WORKER_NAME=worker-1
WORKER_TIMEOUT=300000
WORKER_REPLICAS=2

# Agent Generator Configuration
AGENT_GENERATOR_PORT=8888
AGENT_GENERATION_INTERVAL=30000
TRACE_BATCH_SIZE=50
MAX_CONCURRENT_AGENTS=10

# =============================================================================
# LANGFUSE CONFIGURATION
# =============================================================================

# Langfuse Service Configuration
LANGFUSE_PORT=3001
LANGFUSE_URL=http://localhost:3001
LANGFUSE_HOST=http://langfuse:3000

# Langfuse Authentication
LANGFUSE_NEXTAUTH_SECRET=your-nextauth-secret-min-32-characters-long
LANGFUSE_SALT=your-salt-min-32-characters-long

# Langfuse API Keys (Get from your Langfuse instance)
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key

# Langfuse Features
LANGFUSE_EXPERIMENTAL=true
LANGFUSE_TELEMETRY_ENABLED=false
LANGFUSE_SECURE_HEADERS=true
LANGFUSE_AUTH_PROVIDERS=credentials

# Langfuse Performance
LANGFUSE_CACHE_TTL=3600
LANGFUSE_BATCH_SIZE=1000
LANGFUSE_FLUSH_INTERVAL=5000

# Langfuse Scaling
LANGFUSE_WORKER_MODE=true
LANGFUSE_WORKER_CONCURRENCY=5
LANGFUSE_WORKER_REPLICAS=2
LANGFUSE_INGESTION_PORT=3002
LANGFUSE_INGESTION_MODE=true
LANGFUSE_INGESTION_REPLICAS=3
LANGFUSE_INGESTION_WORKERS=10

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================

# Prometheus Configuration
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d

# Grafana Configuration
GRAFANA_PORT=3002
GRAFANA_USER=admin
GRAFANA_PASSWORD=your-secure-grafana-password
GRAFANA_SECRET_KEY=your-grafana-secret-key
GRAFANA_PLUGINS=grafana-clock-panel,grafana-simple-json-datasource,redis-datasource

# Alertmanager Configuration
ALERTMANAGER_PORT=9093

# Jaeger Configuration (Alternative tracing)
JAEGER_PORT=16686

# Loki Configuration (Log aggregation)
LOKI_PORT=3100

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Supabase Configuration (Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# =============================================================================
# SECURITY & SSL
# =============================================================================

# SSL Configuration
SSL_CERT_PATH=/etc/ssl/certs
SSL_KEY_PATH=/etc/ssl/private

# Security Headers
SECURITY_HEADERS_ENABLED=true
CORS_ENABLED=true
RATE_LIMITING_ENABLED=true

# =============================================================================
# SCALING & HIGH AVAILABILITY
# =============================================================================

# Redis Replication
REDIS_REPLICATION_USER=replicator
REDIS_REPLICATION_PASSWORD=your-replicator-password

# PostgreSQL Replication
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=your-postgres-replicator-password

# Load Balancer Configuration
LOAD_BALANCER_ENABLED=false
CLUSTER_MODE=false

# Consul Configuration
CONSUL_PORT=8500

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# Resource Limits
MAX_MEMORY_USAGE=1G
CLEANUP_INTERVAL=600000

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=100MB

# Metrics Configuration
ENABLE_METRICS=true
METRICS_PORT=9090

# =============================================================================
# DEVELOPMENT SPECIFIC
# =============================================================================

# Development Tools (only for development mode)
PGADMIN_DEFAULT_EMAIL=admin@swarm-dev.local
PGADMIN_DEFAULT_PASSWORD=admin

# Debug Configuration
DEBUG=false
LOG_LEVEL=info

# Hot Reload Configuration
ENABLE_HOT_RELOAD=false
WATCHPACK_POLLING=false
CHOKIDAR_USEPOLLING=false
#!/usr/bin/env node

import { program } from 'commander';
import chalk from 'chalk';
import { readFileSync } from 'fs';
import { fileURLToPath } from 'url';
import { dirname, join } from 'path';
import { SwarmOrchestrator } from '../src/agents/orchestrator.js';
import { MCPServer } from '../src/mcp/server.js';
import { HooksManager } from '../src/hooks/manager.js';
import { MemoryStore } from '../src/memory/store.js';
import { DatabaseManager } from '../src/db/manager.js';
import logger from '../src/utils/logger.js';

const __filename = fileURLToPath(import.meta.url);
const __dirname = dirname(__filename);
const packageJson = JSON.parse(readFileSync(join(__dirname, '../package.json'), 'utf8'));

// Initialize core components
const db = new DatabaseManager();
const memory = new MemoryStore(db);
const hooks = new HooksManager(memory);
const orchestrator = new SwarmOrchestrator(memory, hooks);

program
  .name('claude-flow')
  .description(packageJson.description)
  .version(packageJson.version);

// MCP server command
program
  .command('mcp')
  .description('Start MCP server')
  .option('-p, --port <port>', 'Port to listen on', '3000')
  .option('-m, --mode <mode>', 'Server mode (stdio|http)', 'stdio')
  .action(async (options) => {
    try {
      const server = new MCPServer(orchestrator, memory);
      
      if (options.mode === 'stdio') {
        await server.startStdio();
        logger.info('MCP server started in stdio mode');
      } else {
        await server.startHttp(parseInt(options.port));
        logger.info(`MCP server started on port ${options.port}`);
      }
    } catch (error) {
      logger.error('Failed to start MCP server:', error);
      process.exit(1);
    }
  });

// Swarm commands
program
  .command('swarm')
  .description('Manage swarm operations')
  .option('-t, --topology <type>', 'Swarm topology (mesh|hierarchical|ring|star)', 'hierarchical')
  .option('-a, --agents <count>', 'Number of agents', '5')
  .option('-s, --strategy <strategy>', 'Execution strategy', 'adaptive')
  .action(async (options) => {
    try {
      await orchestrator.initSwarm({
        topology: options.topology,
        maxAgents: parseInt(options.agents),
        strategy: options.strategy
      });
      
      console.log(chalk.green('✅ Swarm initialized successfully'));
      console.log(chalk.blue(`📊 Topology: ${options.topology}`));
      console.log(chalk.blue(`👥 Max agents: ${options.agents}`));
      console.log(chalk.blue(`🎯 Strategy: ${options.strategy}`));
    } catch (error) {
      logger.error('Failed to initialize swarm:', error);
      process.exit(1);
    }
  });

// Hooks commands
program
  .command('hooks <action>')
  .description('Manage hooks (pre-task, post-edit, etc.)')
  .option('-d, --description <desc>', 'Task description')
  .option('-f, --file <path>', 'File path for edit hooks')
  .option('-k, --memory-key <key>', 'Memory storage key')
  .option('-m, --message <msg>', 'Notification message')
  .option('--auto-spawn-agents <bool>', 'Auto spawn agents', true)
  .option('--telemetry <bool>', 'Enable telemetry', true)
  .option('--analyze-performance <bool>', 'Analyze performance', true)
  .option('--session-id <id>', 'Session ID for restoration')
  .option('--load-memory <bool>', 'Load memory on restore', true)
  .option('--export-metrics <bool>', 'Export metrics', true)
  .option('--generate-summary <bool>', 'Generate summary', true)
  .action(async (action, options) => {
    try {
      const result = await hooks.executeHook(action, options);
      
      if (result.success) {
        console.log(chalk.green(`✅ ${action} hook executed successfully`));
        if (result.data) {
          console.log(chalk.gray(JSON.stringify(result.data, null, 2)));
        }
      } else {
        console.log(chalk.red(`❌ ${action} hook failed: ${result.error}`));
      }
    } catch (error) {
      logger.error(`Hook execution failed:`, error);
      process.exit(1);
    }
  });

// Task command
program
  .command('task <description>')
  .description('Execute a task with swarm orchestration')
  .option('-p, --priority <level>', 'Task priority (low|medium|high|critical)', 'medium')
  .option('-s, --strategy <strategy>', 'Execution strategy', 'adaptive')
  .option('-a, --agents <count>', 'Number of agents to use')
  .action(async (description, options) => {
    try {
      const taskResult = await orchestrator.orchestrateTask({
        task: description,
        priority: options.priority,
        strategy: options.strategy,
        maxAgents: options.agents ? parseInt(options.agents) : undefined
      });
      
      console.log(chalk.green('✅ Task orchestrated successfully'));
      console.log(chalk.blue(`📋 Task ID: ${taskResult.taskId}`));
      console.log(chalk.blue(`🎯 Status: ${taskResult.status}`));
    } catch (error) {
      logger.error('Task orchestration failed:', error);
      process.exit(1);
    }
  });

// Memory command
program
  .command('memory <action>')
  .description('Manage persistent memory')
  .option('-k, --key <key>', 'Memory key')
  .option('-v, --value <value>', 'Memory value (JSON string)')
  .option('-n, --namespace <ns>', 'Memory namespace', 'default')
  .option('--ttl <seconds>', 'Time to live in seconds')
  .option('-p, --pattern <pattern>', 'Search pattern')
  .action(async (action, options) => {
    try {
      let result;
      
      switch (action) {
        case 'store':
          if (!options.key || !options.value) {
            throw new Error('Key and value required for store action');
          }
          result = await memory.store(
            options.key,
            JSON.parse(options.value),
            options.namespace,
            options.ttl
          );
          console.log(chalk.green('✅ Value stored successfully'));
          break;
          
        case 'retrieve':
          if (!options.key) {
            throw new Error('Key required for retrieve action');
          }
          result = await memory.retrieve(options.key, options.namespace);
          console.log(chalk.blue('📦 Retrieved value:'));
          console.log(JSON.stringify(result, null, 2));
          break;
          
        case 'list':
          result = await memory.list(options.namespace);
          console.log(chalk.blue('📋 Memory keys:'));
          result.forEach(key => console.log(`  - ${key}`));
          break;
          
        case 'search':
          if (!options.pattern) {
            throw new Error('Pattern required for search action');
          }
          result = await memory.search(options.pattern, options.namespace);
          console.log(chalk.blue('🔍 Search results:'));
          result.forEach(item => console.log(`  - ${item.key}: ${JSON.stringify(item.value)}`));
          break;
          
        default:
          throw new Error(`Unknown memory action: ${action}`);
      }
    } catch (error) {
      logger.error('Memory operation failed:', error);
      process.exit(1);
    }
  });

// Installation helper
program
  .command('install')
  .description('Install claude-flow globally and set up PATH')
  .action(async () => {
    try {
      const { execSync } = await import('child_process');
      
      console.log(chalk.blue('🔧 Installing claude-flow globally...'));
      execSync('npm install -g .', { stdio: 'inherit', cwd: join(__dirname, '..') });
      
      console.log(chalk.green('✅ Installation complete!'));
      console.log(chalk.gray('You can now use claude-flow commands from anywhere'));
    } catch (error) {
      logger.error('Installation failed:', error);
      process.exit(1);
    }
  });

// Parse command line arguments
program.parse(process.argv);
# Claude Flow Environment Configuration

# Server Configuration
NODE_ENV=production
PORT=8080
MCP_SERVER_PORT=8081

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/claude_flow
REDIS_URL=redis://redis:6379

# Langfuse Configuration
LANGFUSE_SECRET_KEY=sk-lf-test
LANGFUSE_PUBLIC_KEY=pk-lf-test
LANGFUSE_BASE_URL=http://langfuse-server:3000

# Swarm Configuration
SWARM_COORDINATION_ENABLED=true
MCP_SERVER_ENABLED=true

# Agent Configuration
AGENT_TYPES=researcher,coder,analyst,tester,coordinator
WORKER_CONCURRENCY=2

# Dashboard Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_LANGFUSE_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dashboard-secret
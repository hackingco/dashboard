# Langfuse Tracing Configuration for Claude-Flow
# Copy this file to .env.tracing and configure your settings

# === BASIC SETTINGS ===
LANGFUSE_ENABLED=true
LANGFUSE_SECRET_KEY=your-secret-key-here
LANGFUSE_PUBLIC_KEY=your-public-key-here
LANGFUSE_HOST=https://cloud.langfuse.com

# === PERFORMANCE SETTINGS ===
LANGFUSE_FLUSH_AT=10
LANGFUSE_FLUSH_INTERVAL=1000
LANGFUSE_REQUEST_TIMEOUT=10000
LANGFUSE_BATCH_SIZE=100
LANGFUSE_MAX_RETRIES=3
LANGFUSE_RETRY_DELAY=1000

# === DEBUG AND LOGGING ===
LANGFUSE_DEBUG=false
LANGFUSE_LOG_LEVEL=info

# === INSTRUMENTATION SETTINGS ===
LANGFUSE_INSTRUMENT_MCP=true
LANGFUSE_INSTRUMENT_SWARM=true
LANGFUSE_INSTRUMENT_HOOKS=true
LANGFUSE_INSTRUMENT_MEMORY=true

# === SAMPLING AND FILTERING ===
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_EXCLUDE_TOOLS=
LANGFUSE_INCLUDE_TOOLS=

# === METADATA AND TAGS ===
LANGFUSE_DEFAULT_TAGS=claude-flow,mcp,swarm
LANGFUSE_ENVIRONMENT=development
LANGFUSE_VERSION=2.0.0

# === PRIVACY AND SECURITY ===
LANGFUSE_MASK_SENSITIVE=true
LANGFUSE_SENSITIVE_KEYS=password,token,key,secret,api_key,access_token

# === STORAGE AND PERSISTENCE ===
LANGFUSE_PERSIST_TRACES=false
LANGFUSE_TRACE_STORAGE_PATH=./traces
LANGFUSE_MAX_TRACE_AGE=86400

# === ADVANCED SETTINGS ===
# Context settings
CLAUDE_FLOW_SESSION_ID=
CLAUDE_FLOW_SWARM_ID=
CLAUDE_FLOW_AGENT_ID=

# Performance monitoring
LANGFUSE_ENABLE_PERFORMANCE_MONITORING=true
LANGFUSE_SLOW_OPERATION_THRESHOLD=5000
LANGFUSE_HIGH_MEMORY_THRESHOLD=500

# Health check settings
LANGFUSE_HEALTH_CHECK_INTERVAL=60000
LANGFUSE_HEALTH_CHECK_ENABLED=true

# === DOCKER SETTINGS ===
# When running in Docker, you might need to adjust these
LANGFUSE_DOCKER_MODE=false
LANGFUSE_CONTAINER_NAME=claude-flow-tracing

# === DEVELOPMENT SETTINGS ===
# Only for development/testing
LANGFUSE_MOCK_MODE=false
LANGFUSE_TEST_MODE=false
LANGFUSE_VERBOSE_LOGGING=false

# === PRODUCTION SETTINGS ===
# For production deployments
LANGFUSE_PRODUCTION_MODE=false
LANGFUSE_ENABLE_METRICS_EXPORT=true
LANGFUSE_METRICS_EXPORT_INTERVAL=300000

# === CLAUDE-FLOW SPECIFIC ===
# These settings are specific to claude-flow integration
CLAUDE_FLOW_TRACING_ENABLED=true
CLAUDE_FLOW_AUTO_INSTRUMENT=true
CLAUDE_FLOW_TRACE_MCP_CALLS=true
CLAUDE_FLOW_TRACE_SWARM_OPERATIONS=true
CLAUDE_FLOW_TRACE_NEURAL_TRAINING=true
CLAUDE_FLOW_TRACE_MEMORY_OPERATIONS=true
CLAUDE_FLOW_TRACE_HOOK_EXECUTIONS=true

# === EXAMPLES ===
# Here are some example configurations for different scenarios:

# Example 1: Local Development
# LANGFUSE_ENABLED=true
# LANGFUSE_DEBUG=true
# LANGFUSE_SAMPLE_RATE=1.0
# LANGFUSE_ENVIRONMENT=development

# Example 2: Production
# LANGFUSE_ENABLED=true
# LANGFUSE_DEBUG=false
# LANGFUSE_SAMPLE_RATE=0.1
# LANGFUSE_ENVIRONMENT=production
# LANGFUSE_PRODUCTION_MODE=true

# Example 3: Testing
# LANGFUSE_ENABLED=true
# LANGFUSE_TEST_MODE=true
# LANGFUSE_MOCK_MODE=true
# LANGFUSE_ENVIRONMENT=test

# Example 4: High-Performance Setup
# LANGFUSE_ENABLED=true
# LANGFUSE_FLUSH_AT=50
# LANGFUSE_FLUSH_INTERVAL=500
# LANGFUSE_BATCH_SIZE=200
# LANGFUSE_SAMPLE_RATE=0.5

# Example 5: Security-Focused
# LANGFUSE_ENABLED=true
# LANGFUSE_MASK_SENSITIVE=true
# LANGFUSE_SENSITIVE_KEYS=password,token,key,secret,api_key,access_token,bearer
# LANGFUSE_EXCLUDE_TOOLS=sensitive_tool_1,sensitive_tool_2

# === NOTES ===
# - Set LANGFUSE_ENABLED=false to disable tracing entirely
# - Use LANGFUSE_SAMPLE_RATE to control how many traces are sent (0.0 to 1.0)
# - LANGFUSE_DEBUG=true provides verbose logging for troubleshooting
# - Adjust LANGFUSE_FLUSH_AT and LANGFUSE_FLUSH_INTERVAL for performance tuning
# - Use LANGFUSE_MASK_SENSITIVE=true to automatically mask sensitive data
# - Set appropriate LANGFUSE_ENVIRONMENT for each deployment stage